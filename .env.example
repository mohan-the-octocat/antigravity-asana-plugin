# .env.example
# Copy this file to .env and fill in your personal credentials:
#   cp .env.example .env

# Your Asana Personal Access Token (PAT)
# Generate from: https://app.asana.com/0/my-apps
ASANA_ACCESS_TOKEN=your_asana_personal_access_token_here

# The Asana Workspace GID (Organization ID)
# Default: Google Workspace (8468971550303)
ASANA_WORKSPACE_GID=8468971550303

# The Asana Team GID to scope operations
# Default: GCA GTM Team (1213807836434813)
ASANA_TEAM_GID=1213807836434813

# Strict scoping prevents cross-team or cross-workspace modifications
ASANA_STRICT_SCOPE=true
